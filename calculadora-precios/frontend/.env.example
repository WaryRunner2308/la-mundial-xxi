VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional. Dominio donde viven las funciones servidor (/api/...). Sirve para
# apuntar a un despliegue de prueba o al servidor local. Si se deja vacio, la
# app usa produccion (https://la-mundial-xxi.vercel.app).
VITE_URL_API=

# La clave de Gemini (gratis, aistudio.google.com) NO va aqui (con VITE_
# quedaria expuesta en el bundle). Se configura como GEMINI_API_KEY (sin
# prefijo VITE_) en las variables de entorno del proyecto en Vercel, para
# que solo la vea frontend/api/scan-invoice.ts.
